APP_ENV=development
# demo uses fictional fixtures and never calls paid providers. Use live for real enrichment.
APP_MODE=demo
APP_PORT=8000
DATABASE_URL=postgresql+psycopg://leadscoring:leadscoring@localhost:5433/leadscoring
REDIS_URL=redis://localhost:6379/0
# Comma-separated browser origins allowed to call the local API.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

PROFILE_PROVIDER=apify
QUALIFICATION_PROVIDER=jev

APIFY_API_KEY=
APIFY_PROFILE_ACTOR_ID=AgfKk0sQQxkpQJ1Dt
APIFY_REQUEST_TIMEOUT_SECONDS=20
APIFY_RUN_TIMEOUT_SECONDS=180
APIFY_POLL_INTERVAL_SECONDS=2
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
JEV_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
JEV_REQUEST_TIMEOUT_SECONDS=30
OPENAI_API_KEY=
COMPANY_ENRICH_API_KEY=
COMPANY_ENRICH_REQUEST_TIMEOUT_SECONDS=45
PRIORITIZATION_MODEL=openai/gpt-6-luna
PRIORITIZATION_REASONING_EFFORT=medium
PRIORITIZATION_REQUEST_TIMEOUT_SECONDS=45
SIGNALHIRE_API_KEY=
SIGNALHIRE_CALLBACK_BASE_URL=
SIGNALHIRE_REQUEST_TIMEOUT_SECONDS=30
# Required to access contact PII at /internal/prospects/{prospect_id}/contact.
INTERNAL_API_KEY=

CELERY_WORKER_CONCURRENCY=4
PHASE1_MAX_CONCURRENCY=4
PHASE2_MAX_CONCURRENCY=4
COMPANY_PROVIDER_MAX_CONCURRENCY=2
CONTACT_PROVIDER_MAX_CONCURRENCY=2
LLM_MAX_CONCURRENCY=2
MAX_RETRY_ATTEMPTS=3

# Contact callback deadline; unknown outcomes require confirmed manual retry.
CONTACT_CALLBACK_TIMEOUT_SECONDS=900
